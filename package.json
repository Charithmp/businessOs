{
  "name": "business-operating-system",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "pnpm --parallel --filter @bos/api --filter @bos/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @bos/db generate",
    "db:migrate": "pnpm --filter @bos/db migrate"
  },
  "devDependencies": {
    "turbo": "^2.3.3"
  }
}
