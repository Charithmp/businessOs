generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrganizationType {
  PLATFORM
  AGENCY
  BUSINESS
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
  EXPIRED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  SUPPORT_ACCESS
  GRANT
  REVOKE
  PUBLISH
}

enum WebsiteStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum WebsiteVersionStatus {
  DRAFT
  READY
  PUBLISHED
  ROLLED_BACK
}

enum DomainStatus {
  PENDING_VERIFICATION
  VERIFIED
  SSL_PENDING
  ACTIVE
  SUSPENDED
}

enum DeploymentStatus {
  QUEUED
  BUILDING
  READY
  FAILED
  ROLLED_BACK
}

enum AiRequestStatus {
  PENDING
  SUCCEEDED
  FAILED
}

model User {
  id           String               @id @default(cuid())
  email        String               @unique
  displayName  String?
  memberships  OrganizationMember[]
  sessions     Session[]
  auditActions AuditLog[]           @relation("AuditActor")
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
}

model Session {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
}

model Organization {
  id            String               @id @default(cuid())
  parentId      String?
  type          OrganizationType
  status        OrganizationStatus   @default(ACTIVE)
  name          String
  slug          String               @unique
  country       String?
  timezone      String               @default("UTC")
  locale        String               @default("en")
  currency      String               @default("USD")
  parent        Organization?        @relation("OrganizationTree", fields: [parentId], references: [id])
  children      Organization[]       @relation("OrganizationTree")
  memberships   OrganizationMember[]
  subscriptions Subscription[]
  auditLogs     AuditLog[]
  supportAccess SupportAccess[]
  websites      Website[]
  domains       Domain[]
  deployments   Deployment[]
  aiRequests    AiRequest[]

  @@index([parentId, type, status])
}

model OrganizationMember {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  roles          MemberRole[]

  @@unique([organizationId, userId])
  @@index([userId])
}

model Role {
  id          String           @id @default(cuid())
  name        String
  permissions RolePermission[]
  members     MemberRole[]

  @@unique([name])
}

model Permission {
  id    String           @id @default(cuid())
  name  String           @unique
  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model MemberRole {
  memberId String
  roleId   String
  member   OrganizationMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  role     Role               @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([memberId, roleId])
}

model Product {
  id        String    @id @default(cuid())
  key       String    @unique
  name      String
  features  Feature[]
  createdAt DateTime  @default(now())
}

model Feature {
  id              String           @id @default(cuid())
  key             String           @unique
  name            String
  productId       String
  product         Product          @relation(fields: [productId], references: [id])
  packageFeatures PackageFeature[]
}

model Package {
  id            String           @id @default(cuid())
  key           String
  version       Int
  name          String
  active        Boolean          @default(true)
  features      PackageFeature[]
  subscriptions Subscription[]

  @@unique([key, version])
}

model PackageFeature {
  packageId String
  featureId String
  enabled   Boolean @default(true)
  package   Package @relation(fields: [packageId], references: [id], onDelete: Cascade)
  feature   Feature @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@id([packageId, featureId])
}

model Subscription {
  id             String                @id @default(cuid())
  organizationId String
  packageId      String
  status         SubscriptionStatus    @default(TRIAL)
  startsAt       DateTime              @default(now())
  endsAt         DateTime?
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  package        Package               @relation(fields: [packageId], references: [id])
  limits         SubscriptionLimit[]
  history        SubscriptionHistory[]

  @@index([organizationId, status])
}

model SubscriptionLimit {
  id             String       @id @default(cuid())
  subscriptionId String
  key            String
  value          Int
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, key])
}

model SubscriptionHistory {
  id             String       @id @default(cuid())
  subscriptionId String
  action         String
  before         Json?
  after          Json?
  actorId        String?
  createdAt      DateTime     @default(now())
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id             String       @id @default(cuid())
  organizationId String
  actorId        String?
  action         AuditAction
  resourceType   String
  resourceId     String?
  before         Json?
  after          Json?
  reason         String?
  requestId      String?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id])
  actor          User?        @relation("AuditActor", fields: [actorId], references: [id])

  @@index([organizationId, createdAt])
  @@index([resourceType, resourceId])
}

model SystemLog {
  id             String   @id @default(cuid())
  level          String
  event          String
  requestId      String?
  organizationId String?
  metadata       Json?
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt])
}

model SecurityEvent {
  id             String   @id @default(cuid())
  organizationId String?
  type           String
  severity       String
  metadata       Json?
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt])
}

model SupportAccess {
  id             String       @id @default(cuid())
  organizationId String
  actorId        String
  reason         String
  startsAt       DateTime     @default(now())
  expiresAt      DateTime
  revokedAt      DateTime?
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, expiresAt])
}

model Website {
  id                 String           @id @default(cuid())
  organizationId     String
  name               String
  slug               String
  status             WebsiteStatus    @default(DRAFT)
  publishedVersionId String?          @unique
  organization       Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  versions           WebsiteVersion[] @relation("WebsiteVersions")
  publishedVersion   WebsiteVersion?  @relation("PublishedWebsiteVersion", fields: [publishedVersionId], references: [id])
  domains            Domain[]
  deployments        Deployment[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@unique([organizationId, slug])
  @@index([organizationId, status])
}

model WebsiteVersion {
  id            String               @id @default(cuid())
  websiteId     String
  number        Int
  status        WebsiteVersionStatus @default(DRAFT)
  componentTree Json
  createdById   String?
  website       Website              @relation("WebsiteVersions", fields: [websiteId], references: [id], onDelete: Cascade)
  publishedBy   Website?             @relation("PublishedWebsiteVersion")
  deployments   Deployment[]
  createdAt     DateTime             @default(now())

  @@unique([websiteId, number])
  @@index([websiteId, status])
}

model WebsiteTemplate {
  id             String   @id @default(cuid())
  organizationId String?
  name           String
  slug           String   @unique
  componentTree  Json
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
}

model Domain {
  id                String       @id @default(cuid())
  organizationId    String
  websiteId         String
  hostname          String       @unique
  status            DomainStatus @default(PENDING_VERIFICATION)
  verificationToken String       @unique
  verifiedAt        DateTime?
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  website           Website      @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([organizationId, status])
  @@index([websiteId, status])
}

model Deployment {
  id               String           @id @default(cuid())
  organizationId   String
  websiteId        String
  websiteVersionId String
  status           DeploymentStatus @default(QUEUED)
  immutableRef     String           @unique
  error            String?
  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  website          Website          @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  version          WebsiteVersion   @relation(fields: [websiteVersionId], references: [id], onDelete: Cascade)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([organizationId, status])
  @@index([websiteId, createdAt])
}

model AiProvider {
  id        String   @id @default(cuid())
  key       String   @unique
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model AiRequest {
  id             String          @id @default(cuid())
  organizationId String
  provider       String
  model          String
  requestType    String
  fingerprint    String
  status         AiRequestStatus @default(PENDING)
  input          Json?
  output         Json?
  tokenCount     Int?
  estimatedCost  Decimal?        @db.Decimal(18, 6)
  latencyMs      Int?
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime        @default(now())

  @@unique([organizationId, fingerprint])
  @@index([organizationId, createdAt])
  @@index([provider, model, createdAt])
}
